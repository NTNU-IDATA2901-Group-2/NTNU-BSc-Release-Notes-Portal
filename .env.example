CORS_ALLOWED_ORIGINS=YOUR_ALLOWED_COMMA_SEPARATED_ORIGINS

# Bootstrap admin account for the dev Keycloak container only (docker-compose.yml)
KC_USERNAME=YOUR_KEYCLOAK_ADMIN_USERNAME
KC_PASSWORD=YOUR_KEYCLOAK_ADMIN_PASSWORD

# OIDC provider used by the app (any spec-compliant IdP: Keycloak, Entra ID, ...)
OIDC_ISSUER_URI=YOUR_OIDC_ISSUER_URI
OIDC_CLIENT_ID=YOUR_OIDC_CLIENT_ID
OIDC_SCOPES=openid profile
# Optional overrides (defaults shown; see README "Identity Provider Configuration")
# OIDC_AUDIENCE=
# OIDC_ROLES_CLAIM=roles
# OIDC_CUSTOMER_CLAIM=groups
# OIDC_CUSTOMER_PREFIX=/Customers/

DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_DATABASE=YOUR_DATABASE_NAME
DB_URL=YOUR_JDBC_DATABASE_URL

OPENAI_URL=YOUR_OPENAI_URL
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_CHAT_COMPLETIONS_PATH=YOUR_OPENAI_CHAT_COMPLETIONS_PATH
OPENAI_MODEL=YOUR_OPENAI_MODEL

JIRA_BASE_URL=YOUR_JIRA_BASE_URL
JIRA_EMAIL=YOUR_JIRA_EMAIL
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN

CHANGE_NOTE_DIRECTORY=YOUR_CHANGE_NOTE_DIRECTORY
RELEASE_NOTE_DIRECTORY=YOUR_RELEASE_NOTE_DIRECTORY

GITHUB_RW_PAT=YOUR_GITHUB_RW_PERSONAL_ACCESS_TOKEN