meta {
  name: get_all_filter_customerId
  type: http
  seq: 14
}

get {
  url: {{baseurl}}/changenotes?customerId=2
  body: none
  auth: inherit
}

params:query {
  customerId: 2
}

assert {
  res.body[0].id: eq {{change_id_2}}
  res.body: length 1
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
