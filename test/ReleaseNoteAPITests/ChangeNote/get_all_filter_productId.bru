meta {
  name: get_all_filter_productId
  type: http
  seq: 11
}

get {
  url: {{baseurl}}/changenotes?productId=1
  body: none
  auth: inherit
}

params:query {
  productId: 1
}

assert {
  res.body[0].id: eq {{change_id_1}}
  res.body: length 1
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
