meta {
  name: positive_change_note_excludes_archived_release_note
  type: http
  seq: 72
}

get {
  url: {{baseurl}}/changenotes/{{change_id_rn_exclusion}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.relatedReleaseNoteIds: length 0
}

settings {
  encodeUrl: true
  timeout: 0
}
