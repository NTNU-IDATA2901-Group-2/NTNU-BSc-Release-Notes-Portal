meta {
  name: positive_get_all_filter_date_excluding_to
  type: http
  seq: 38
}

get {
  url: {{baseurl}}/changenotes?toDate={{date_filter_to}}
  body: none
  auth: inherit
}

params:query {
  toDate: {{date_filter_to}}
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

script:pre-request {
  // toDate set to the day BEFORE the note was created. The note's createdAt is not before
  // startOfDay(toDate + 1), so it must be filtered out.
  const base = new Date(bru.getEnvVar("change_note_1_created_date") + "T12:00:00Z")
  base.setUTCDate(base.getUTCDate() - 1)
  bru.setEnvVar("date_filter_to", base.toISOString().slice(0, 10))
}

tests {
  const ids = res.body.map(cn => String(cn.id))
  expect(ids).to.not.include(String(bru.getEnvVar("change_id_1")))
}

settings {
  encodeUrl: true
  timeout: 0
}
