meta {
  name: positive_get_all_filter_date_on_from
  type: http
  seq: 35
}

get {
  url: {{baseurl}}/changenotes?fromDate={{date_filter_from}}
  body: none
  auth: inherit
}

params:query {
  fromDate: {{date_filter_from}}
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

script:pre-request {
  // fromDate exactly on the note's creation day. The lower bound is inclusive
  // (createdAt >= startOfDay(fromDate)), so the note must be returned.
  bru.setEnvVar("date_filter_from", bru.getEnvVar("change_note_1_created_date"))
}

tests {
  const ids = res.body.map(cn => String(cn.id))
  expect(ids).to.include(String(bru.getEnvVar("change_id_1")))
}

settings {
  encodeUrl: true
  timeout: 0
}
