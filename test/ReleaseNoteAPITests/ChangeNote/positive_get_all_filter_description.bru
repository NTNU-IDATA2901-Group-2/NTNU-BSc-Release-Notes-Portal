meta {
  name: positive_get_all_filter_description
  type: http
  seq: 15
}

get {
  url: {{baseurl}}/changenotes?query=what changed for
  body: none
  auth: inherit
}

params:query {
  query: what changed for
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body[0].id: eq {{change_id_2}}
  res.body: length 1
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
