meta {
  name: positive_get_all_filter_featureId
  type: http
  seq: 25
}

get {
  url: {{baseurl}}/changenotes?featureIds=1
  body: none
  auth: inherit
}

params:query {
  featureIds: 1
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body.content[0].id: eq {{change_id_1}}
  res.body.content: length 1
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
