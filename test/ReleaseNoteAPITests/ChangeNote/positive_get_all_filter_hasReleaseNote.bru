meta {
  name: positive_get_all_filter_hasReleaseNote
  type: http
  seq: 32
}

get {
  url: {{baseurl}}/changenotes?hasReleaseNote=true
  body: none
  auth: inherit
}

params:query {
  hasReleaseNote: true
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body: length 1
  res.status: eq 200
  res.body[0].id: eq {{change_id_1}}
  res.body[0].relatedReleaseNoteIds[0]: eq {{release_id_1}}
}

settings {
  encodeUrl: true
  timeout: 0
}
