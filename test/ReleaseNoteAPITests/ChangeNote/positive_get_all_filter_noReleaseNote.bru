meta {
  name: positive_get_all_filter_noReleaseNote
  type: http
  seq: 46
}

get {
  url: {{baseurl}}/changenotes?hasReleaseNote=false
  body: none
  auth: inherit
}

params:query {
  hasReleaseNote: false
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body.content: length 2
  res.status: eq 200
  res.body.content[0].id: eq {{change_id_3}}
  res.body.content[1].id: eq {{change_id_2}}
}

settings {
  encodeUrl: true
  timeout: 0
}
