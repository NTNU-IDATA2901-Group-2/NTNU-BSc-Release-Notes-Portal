meta {
  name: positive_get_all_filter_noScope
  type: http
  seq: 24
}

get {
  url: {{baseurl}}/changenotes?includeUnassignedScope=true
  body: none
  auth: inherit
}

params:query {
  includeUnassignedScope: true
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body.content: length 1
  res.status: eq 200
  res.body.content[0].id: eq {{change_id_3}}
}

settings {
  encodeUrl: true
  timeout: 0
}
