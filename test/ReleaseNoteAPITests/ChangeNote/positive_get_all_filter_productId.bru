meta {
  name: positive_get_all_filter_productId
  type: http
  seq: 18
}

get {
  url: {{baseurl}}/changenotes?productIds=1
  body: none
  auth: inherit
}

params:query {
  productIds: 1
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body[0].id: eq {{change_id_1}}
  res.body: length 1
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
