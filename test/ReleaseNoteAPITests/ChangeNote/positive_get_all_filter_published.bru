meta {
  name: positive_get_all_filter_published
  type: http
  seq: 28
}

get {
  url: {{baseurl}}/changenotes?published=true
  body: none
  auth: inherit
}

params:query {
  published: true
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.content: length 1
  res.body.content[0].id: eq {{change_id_2}}
}

settings {
  encodeUrl: true
  timeout: 0
}
