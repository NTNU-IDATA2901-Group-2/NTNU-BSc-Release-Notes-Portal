meta {
  name: positive_get_all_pagination_size_exceeds_total
  type: http
  seq: 50
}

get {
  url: {{baseurl}}/changenotes?page=0&size=50
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 50
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.content: length 3
  res.body.totalItems: eq 3
}

settings {
  encodeUrl: true
  timeout: 0
}
