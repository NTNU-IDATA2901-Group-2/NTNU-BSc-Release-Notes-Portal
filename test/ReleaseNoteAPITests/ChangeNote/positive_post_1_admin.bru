meta {
  name: positive_post_1_admin
  type: http
  seq: 2
}

post {
  url: {{baseurl}}/changenotes
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "title": "title 1",
    "reference" : "reference 1",
    "description": "This is what changed",
    "developerNotes": "Hello dev",
    "upgradeNotes": "Upgrade if you want to",
    "customerId": 1,
    "featureId": 1,
    "scopeId": 1,
    "productId": 1
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("change_id_1", res.body)
  // Capture the calendar date (Europe/Oslo, the server's business zone) the note was
  // created on, so the date-filter tests can build fromDate/toDate around it.
  bru.setEnvVar("change_note_1_created_date", new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Oslo" }))
}

settings {
  encodeUrl: true
  timeout: 0
}
