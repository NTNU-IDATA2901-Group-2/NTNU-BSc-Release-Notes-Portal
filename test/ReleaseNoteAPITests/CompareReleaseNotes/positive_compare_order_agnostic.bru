meta {
  name: positive_compare_order_agnostic
  type: http
  seq: 7
}

get {
  url: {{baseurl}}/releasenotes/compare?releaseNoteOneId={{compare_rn_new}}&releaseNoteTwoId={{compare_rn_old}}
  body: none
  auth: inherit
}

params:query {
  releaseNoteOneId: {{compare_rn_new}}
  releaseNoteTwoId: {{compare_rn_old}}
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

tests {
  // Order of the two parameters must not matter: the older note is determined by
  // createdAt, so the result is identical to passing them the other way around.
  const ids = res.body.map(rn => String(rn.id))
  expect(res.body.length).to.equal(2)
  expect(ids).to.include(String(bru.getEnvVar("compare_rn_new")))
  expect(ids).to.include(String(bru.getEnvVar("compare_rn_mid")))
  expect(ids).to.not.include(String(bru.getEnvVar("compare_rn_old")))
  expect(String(res.body[0].id)).to.equal(String(bru.getEnvVar("compare_rn_new")))
}

settings {
  encodeUrl: true
  timeout: 0
}
