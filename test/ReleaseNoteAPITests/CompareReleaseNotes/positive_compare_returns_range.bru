meta {
  name: positive_compare_returns_range
  type: http
  seq: 6
}

get {
  url: {{baseurl}}/releasenotes/compare?releaseNoteOneId={{compare_rn_old}}&releaseNoteTwoId={{compare_rn_new}}
  body: none
  auth: inherit
}

params:query {
  releaseNoteOneId: {{compare_rn_old}}
  releaseNoteTwoId: {{compare_rn_new}}
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

tests {
  // The range excludes the older "from" note and includes every later note up to and
  // including the newer "to" note, ordered most-recent-first.
  const ids = res.body.map(rn => String(rn.id))
  expect(res.body.length).to.equal(2)
  expect(ids).to.include(String(bru.getEnvVar("compare_rn_new")))
  expect(ids).to.include(String(bru.getEnvVar("compare_rn_mid")))
  expect(ids).to.not.include(String(bru.getEnvVar("compare_rn_old")))
  expect(String(res.body[0].id)).to.equal(String(bru.getEnvVar("compare_rn_new")))
}

settings {
  encodeUrl: true
  timeout: 0
}
