meta {
  name: post_compare_no_product
  type: http
  seq: 5
}

post {
  url: {{baseurl}}/releasenotes
  body: json
  auth: none
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "tag": "compare-noproduct-v1.0.0",
    "summary": "Release note without a product",
    "published": true
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("compare_rn_no_product", res.body)
}
