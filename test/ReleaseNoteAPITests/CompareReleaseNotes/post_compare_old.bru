meta {
  name: post_compare_old
  type: http
  seq: 1
}

post {
  url: {{baseurl}}/releasenotes
  body: json
  auth: none
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "tag": "compare-v1.0.0",
    "summary": "Oldest release in the comparison range",
    "published": true,
    "productId": 1
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  // Created first, so this is the oldest note and the excluded "from" of the range.
  bru.setEnvVar("compare_rn_old", res.body)
}
