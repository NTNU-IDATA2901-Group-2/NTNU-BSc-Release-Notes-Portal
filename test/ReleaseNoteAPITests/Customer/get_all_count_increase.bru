meta {
  name: get_all_count_increase
  type: http
  seq: 5
}

get {
  url: {{baseurl}}/customers?X-Test-Role=Admin
  body: none
  auth: inherit
}

params:query {
  X-Test-Role: Admin
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body.length: gt {{customer_count}}
}

settings {
  encodeUrl: true
  timeout: 0
}
