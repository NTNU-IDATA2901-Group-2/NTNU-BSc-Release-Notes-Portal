meta {
  name: get_updated_customers_by_id
  type: http
  seq: 7
}

get {
  url: {{baseurl}}/customers/{{customer_create_customer}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body: isJson
  res.body.id: eq {{customer_create_customer}}
  res.body.name: eq ChangedTest
}

settings {
  encodeUrl: true
  timeout: 0
}
