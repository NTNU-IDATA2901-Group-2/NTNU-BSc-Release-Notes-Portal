meta {
  name: post_customer
  type: http
  seq: 2
}

post {
  url: {{baseurl}}/customers
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "name" : "testCustomer"
  }
}

assert {
  res.body: isNumber
}

script:post-response {
  bru.setEnvVar("customer_create_customer", res.body)
}

settings {
  encodeUrl: true
  timeout: 0
}
