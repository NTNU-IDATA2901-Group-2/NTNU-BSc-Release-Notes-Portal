meta {
  name: negative_diff_mismatched_product
  type: http
  seq: 9
}

get {
  url: {{baseurl}}/releasenotes/diff?releaseNoteOneId={{diff_rn_old}}&releaseNoteTwoId={{diff_rn_other_product}}
  body: none
  auth: inherit
}

params:query {
  releaseNoteOneId: {{diff_rn_old}}
  releaseNoteTwoId: {{diff_rn_other_product}}
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 400
}

settings {
  encodeUrl: true
  timeout: 0
}
