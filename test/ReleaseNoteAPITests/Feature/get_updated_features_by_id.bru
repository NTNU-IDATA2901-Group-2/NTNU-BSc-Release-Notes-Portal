meta {
  name: get_updated_features_by_id
  type: http
  seq: 7
}

get {
  url: {{baseurl}}/features/{{feature_create_feature}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body: isJson
  res.body.id: eq {{feature_create_feature}}
  res.body.name: eq ChangedTest
}

settings {
  encodeUrl: true
  timeout: 0
}
