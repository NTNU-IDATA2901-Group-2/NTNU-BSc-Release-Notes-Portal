meta {
  name: delete_added_git_repo
  type: http
  seq: 5
}

delete {
  url: {{baseurl}}/git-repositories?id={{createdGitRepositoryId}}
  body: none
  auth: inherit
}

params:query {
  id: {{createdGitRepositoryId}}
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
