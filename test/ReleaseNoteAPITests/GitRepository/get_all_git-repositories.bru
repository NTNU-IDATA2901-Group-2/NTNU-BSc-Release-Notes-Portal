meta {
  name: get_all_git-repositories
  type: http
  seq: 1
}

get {
  url: {{baseurl}}/git-repositories
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setEnvVar("gitRepositoryCountPlusOne", res.body.length + 1)
  bru.setEnvVar("gitRepositoryCount", res.body.length)
  
}

settings {
  encodeUrl: true
  timeout: 0
}
