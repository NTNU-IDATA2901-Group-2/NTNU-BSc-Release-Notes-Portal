meta {
  name: get_all_git-repositories_after_addition
  type: http
  seq: 4
}

get {
  url: {{baseurl}}/git-repositories
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body.length: eq {{gitRepositoryCountPlusOne}}
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
