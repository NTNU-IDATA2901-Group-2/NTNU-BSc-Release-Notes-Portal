meta {
  name: get_all_git-repositories_after_pat_update
  type: http
  seq: 8
}

get {
  url: {{baseurl}}/git-repositories
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
}

tests {
  // The updated PAT must be reflected in patSet without ever being exposed.
  res.body.forEach(repo => expect(repo).to.not.have.property("pat"))
  const created = res.body.find(repo => String(repo.id) === String(bru.getEnvVar("createdGitRepositoryId")))
  expect(created.patSet).to.equal(true)
}

settings {
  encodeUrl: true
  timeout: 0
}
