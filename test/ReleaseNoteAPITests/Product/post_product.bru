meta {
  name: post_product
  type: http
  seq: 2
}

post {
  url: {{baseurl}}/products
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "name" : "testProduct"
  }
}

assert {
  res.body: isNumber
}

script:post-response {
  bru.setEnvVar("product_create_product", res.body)
}

settings {
  encodeUrl: true
  timeout: 0
}
