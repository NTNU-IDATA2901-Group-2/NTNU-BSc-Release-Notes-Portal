meta {
  name: post_product_in_use
  type: http
  seq: 15
}

post {
  url: {{baseurl}}/products
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "name" : "inUseProduct"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("product_in_use_id", res.body)
}

settings {
  encodeUrl: true
  timeout: 0
}
