meta {
  name: reset_prompts
  type: http
  seq: 2
}

put {
  url: {{baseurl}}/ai/prompts
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  [
      {
        "id": 2,
        "name": "Change Notes Summary",
        "prompt": ""
      },
      {
        "id": 1,
        "name": "Translation Prompt",
        "prompt": ""
      }
    ]
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
