  auth: inherit
}

body:json {
  [
      {
        "id": 1,
        "name": "Change Note Summary",
        "prompt": "test"
      }
    ]
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
