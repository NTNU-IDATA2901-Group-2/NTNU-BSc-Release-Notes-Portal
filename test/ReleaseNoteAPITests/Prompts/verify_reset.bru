meta {
  name: verify_reset
  type: http
  seq: 3
}

get {
  url: {{baseurl}}/ai/prompts
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.length: eq 3
  res.body[0].prompt: eq ""
  res.body[1].prompt: eq ""
  res.body[2].prompt: eq ""
}

settings {
  encodeUrl: true
  timeout: 0
}
