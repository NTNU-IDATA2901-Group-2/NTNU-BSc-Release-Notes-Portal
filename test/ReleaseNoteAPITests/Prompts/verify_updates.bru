meta {
  name: verify_updates
  type: http
  seq: 4
}

get {
  url: {{baseurl}}/ai/prompts
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.length: eq 3
  res.body[0].prompt: eq "test"
  res.body[1].prompt: eq "test"
  res.body[2].prompt: eq "e"
}

settings {
  encodeUrl: true
  timeout: 0
}
