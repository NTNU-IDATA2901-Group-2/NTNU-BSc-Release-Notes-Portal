meta {
  name: get_all_filter_productId
  type: http
  seq: 13
}

get {
  url: {{baseurl}}/releasenotes?productIds=1
  body: none
  auth: inherit
}

params:query {
  productIds: 1
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.length: eq 1
  res.body[0].id: eq {{release_id_1}}
}

settings {
  encodeUrl: true
  timeout: 0
}
