meta {
  name: get_all_filter_summary
  type: http
  seq: 12
}

get {
  url: {{baseurl}}/releasenotes?summary=big
  body: none
  auth: inherit
}

params:query {
  summary: big
}

assert {
  res.status: eq 200
  res.body.length: eq 1
  res.body[0].id: eq {{release_id_2}}
}

settings {
  encodeUrl: true
  timeout: 0
}
