meta {
  name: get_valid
  type: http
  seq: 8
}

get {
  url: {{baseurl}}/releasenotes/{{release_id_1}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.changeNotes: length 2
  res.body.tag: eq v1.0.0
  res.body.summary: eq Initial release with core features
  res.body.published: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
