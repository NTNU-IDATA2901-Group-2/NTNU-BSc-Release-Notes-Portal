meta {
  name: negative_get_all_pagination_negative_page
  type: http
  seq: 32
}

get {
  url: {{baseurl}}/releasenotes?page=-1&size=1
  body: none
  auth: inherit
}

params:query {
  page: -1
  size: 1
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 400
}

settings {
  encodeUrl: true
  timeout: 0
}
