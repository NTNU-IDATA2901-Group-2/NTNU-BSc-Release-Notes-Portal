meta {
  name: negative_post_not_admin
  type: http
  seq: 4
}

post {
  url: {{baseurl}}/releasenotes
  body: json
  auth: none
}

body:json {
  {
    "changeNoteIds": [{{change_id_1}}, {{change_id_2}}],
    "tag": "v1.0.0",
    "summary": "Initial release with core features",
    "published": false
  }
}

assert {
  res.status: eq 403
}
