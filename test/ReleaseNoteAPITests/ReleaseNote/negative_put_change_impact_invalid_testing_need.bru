meta {
  name: negative_put_change_impact_invalid_testing_need
  type: http
  seq: 47
}

put {
  url: {{baseurl}}/releasenotes/{{release_id_1}}
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "changeNoteIds": [{{change_id_1}}, {{change_id_2}}],
    "tag": "v1.0.0",
    "summary": "Invalid testing need",
    "published": true,
    "changeImpacts": [
      {
        "featureId": 1,
        "whatIsChanged": "x",
        "whatShouldBeTested": "y",
        "testingNeed": "EXTREME"
      }
    ]
  }
}

assert {
  res.status: eq 400
}

settings {
  encodeUrl: true
  timeout: 0
}
