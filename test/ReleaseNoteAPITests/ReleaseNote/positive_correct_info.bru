meta {
  name: positive_correct_info
  type: http
  seq: 6
}

get {
  url: {{baseurl}}/releasenotes/{{release_id_1}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.id: eq {{release_id_1}}
  res.body.tag: eq "v1.0.0"
  res.body.summary: eq "Initial release with core features"
  res.body.published: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
