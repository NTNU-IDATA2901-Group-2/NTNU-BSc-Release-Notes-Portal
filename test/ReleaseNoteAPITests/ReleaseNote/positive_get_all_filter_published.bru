meta {
  name: positive_get_all_filter_published
  type: http
  seq: 14
}

get {
  url: {{baseurl}}/releasenotes?published=true
  body: none
  auth: inherit
}

params:query {
  published: true
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.content.length: eq 1
  res.body.content[0].id: eq {{release_id_1}}
}

settings {
  encodeUrl: true
  timeout: 0
}
