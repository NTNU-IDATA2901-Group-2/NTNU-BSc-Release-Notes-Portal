meta {
  name: positive_get_all_filter_summary
  type: http
  seq: 14
}

get {
  url: {{baseurl}}/releasenotes?query=big
  body: none
  auth: inherit
}

params:query {
  query: big
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.length: eq 1
  res.body[0].id: eq {{release_id_2}}
}

settings {
  encodeUrl: true
  timeout: 0
}
