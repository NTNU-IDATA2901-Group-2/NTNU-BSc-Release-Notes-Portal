meta {
  name: positive_get_all_filter_tag
  type: http
  seq: 12
}

get {
  url: {{baseurl}}/releasenotes?query=1.
  body: none
  auth: inherit
}

params:query {
  query: 1.
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.length: eq 1
  res.body[0].id: eq {{release_id_1}}
}

settings {
  encodeUrl: true
  timeout: 0
}
