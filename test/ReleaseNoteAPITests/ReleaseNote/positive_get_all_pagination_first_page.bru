meta {
  name: positive_get_all_pagination_first_page
  type: http
  seq: 27
}

get {
  url: {{baseurl}}/releasenotes?page=0&size=1
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 1
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.content.length: eq 1
  res.body.totalItems: eq 2
}

settings {
  encodeUrl: true
  timeout: 0
}
