meta {
  name: positive_get_all_pagination_page_out_of_range
  type: http
  seq: 30
}

get {
  url: {{baseurl}}/releasenotes?page=10&size=1
  body: none
  auth: inherit
}

params:query {
  page: 10
  size: 1
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.content.length: eq 0
  res.body.totalItems: eq 2
}

settings {
  encodeUrl: true
  timeout: 0
}
