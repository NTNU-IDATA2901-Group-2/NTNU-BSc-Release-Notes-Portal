meta {
  name: positive_get_only_visible_changenotes
  type: http
  seq: 9
}

get {
  url: {{baseurl}}/releasenotes/{{release_id_1}}
  body: none
  auth: none
}

headers {
  X-Test-Customers: Liddle
}

assert {
  res.status: eq 200
  res.body.changeNotes: length 1
  res.body.changeNotes[0].id: eq {{change_id_1}}
}
