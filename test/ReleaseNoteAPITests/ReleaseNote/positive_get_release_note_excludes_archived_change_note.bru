meta {
  name: positive_get_release_note_excludes_archived_change_note
  type: http
  seq: 59
}

get {
  url: {{baseurl}}/releasenotes/{{release_id_1}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.changeNotes: length 1
  res.body.changeNotes[0].id: eq {{change_id_2}}
}

settings {
  encodeUrl: true
  timeout: 0
}
