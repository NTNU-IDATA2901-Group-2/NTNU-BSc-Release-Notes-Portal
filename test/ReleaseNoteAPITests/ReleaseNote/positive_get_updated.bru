meta {
  name: positive_get_updated
  type: http
  seq: 54
}

get {
  url: {{baseurl}}/releasenotes/{{release_id_2}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.status: eq 200
  res.body.changeNotes: length 1
  res.body.tag: eq updated
  res.body.summary: eq updated
  res.body.published: eq true
  res.body.releaseTimeline.previewAvailableFrom: eq 2026-07-01
  res.body.releaseTimeline.recommendedTestPhaseFrom: eq 2026-07-08
  res.body.releaseTimeline.recommendedTestPhaseTo: eq 2026-07-15
  res.body.releaseTimeline.plannedProductionDeployment: eq 2026-08-01
  res.body.knownLimitations: length 2
  res.body.knownLimitations[0]: eq limitation-one
  res.body.knownLimitations[1]: eq limitation-two
  res.body.changeImpacts: length 1
  res.body.changeImpacts[0].feature.id: eq 1
  res.body.changeImpacts[0].whatIsChanged: eq "updated change"
  res.body.changeImpacts[0].whatShouldBeTested: eq "updated test"
  res.body.changeImpacts[0].testingNeed: eq MEDIUM
  res.body.product.id: eq 2
}

settings {
  encodeUrl: true
  timeout: 0
}
