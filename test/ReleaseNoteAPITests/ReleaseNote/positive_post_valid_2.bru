meta {
  name: positive_post_valid_2
  type: http
  seq: 9
}

post {
  url: {{baseurl}}/releasenotes
  body: json
  auth: none
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "changeNoteIds": [{{change_id_3}}],
    "tag": "v2.0.0",
    "summary": "Big changes have been made",
    "published": false
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("release_id_2", res.body)
}
