meta {
  name: positive_put_update
  type: http
  seq: 38
}

put {
  url: {{baseurl}}/releasenotes/{{release_id_2}}
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "changeNoteIds": [{{change_id_2}}],
    "tag": "updated",
    "summary": "updated",
    "published": true,
    "releaseTimeline": {
      "previewAvailableFrom": "2026-07-01",
      "recommendedTestPhaseFrom": "2026-07-08",
      "recommendedTestPhaseTo": "2026-07-15",
      "plannedProductionDeployment": "2026-08-01"
    },
    "knownLimitations": ["limitation-one", "limitation-two"]
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
