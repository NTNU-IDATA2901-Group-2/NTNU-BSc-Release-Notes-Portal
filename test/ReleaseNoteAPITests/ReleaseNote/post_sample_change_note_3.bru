meta {
  name: post_sample_change_note_3
  type: http
  seq: 3
}

post {
  url: {{baseurl}}/changenotes
  body: json
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

body:json {
  {
    "reference" : "kjgfkhgfjhfdjhgf",
    "description": "What changed for the users",
    "developerNotes": "What changed from a developers perspective",
    "upgradeNotes": "What needs to be done to upgrade",
    "productId": 2
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("change_id_3", res.body)
}

settings {
  encodeUrl: true
  timeout: 0
}
