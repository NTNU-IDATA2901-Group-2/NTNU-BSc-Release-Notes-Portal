meta {
  name: post_valid_2
  type: http
  seq: 5
}

post {
  url: {{baseurl}}/releasenotes
  body: json
  auth: none
}

body:json {
  {
    "changeNoteIds": [{{change_id_3}}],
    "tag": "v1.0.0",
    "summary": "Initial release with core features",
    "published": false
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("release_id_2", res.body)
}
