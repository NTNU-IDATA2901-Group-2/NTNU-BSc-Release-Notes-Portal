meta {
  name: get_updated_scopes_by_id
  type: http
  seq: 9
}

get {
  url: {{baseurl}}/scopes/{{scope_create_scope}}
  body: none
  auth: inherit
}

headers {
  X-Test-Role: Admin
}

assert {
  res.body: isJson
  res.body.id: eq {{scope_create_scope}}
  res.body.name: eq ChangedTest
}

settings {
  encodeUrl: true
  timeout: 0
}
