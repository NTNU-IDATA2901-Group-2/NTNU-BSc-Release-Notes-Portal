meta {
  name: post_scope
  type: http
  seq: 2
}

post {
  url: {{baseurl}}/scopes
  body: json
  auth: inherit
}

body:json {
  {
    "name" : "testScope"
  }
}

assert {
  res.body: isNumber
}

script:post-response {
  bru.setEnvVar("scope_create_scope", res.body)
}

settings {
  encodeUrl: true
  timeout: 0
}
